# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=3000

# MongoDB Configuration
# 本地 MongoDB 连接示例
MONGODB_URI=mongodb://localhost:27017/aigui
# MongoDB Atlas 云服务连接示例
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aigui?retryWrites=true&w=majority

# OpenAI Store (启用聊天历史续写功能)
OPENAI_STORE=1

# Proxy Configuration (Optional)
# 如果需要使用代理访问 OpenAI API，取消下面两行的注释并设置代理地址
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
